{
  "name": "@dungle-scrubs/harness-cli-normalizer",
  "version": "0.1.1",
  "description": "One stable interface to four coding-agent CLIs that survives their updates.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dungle-scrubs/harness-cli-normalizer.git"
  },
  "homepage": "https://github.com/dungle-scrubs/harness-cli-normalizer#readme",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:bun",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun test",
    "prepare": "git config --local core.hooksPath .git/hooks && lefthook install --force",
    "smoke:claude": "bun scripts/smoke-claude.ts",
    "smoke:all": "bun scripts/smoke-all.ts",
    "demo": "bun scripts/demo.ts",
    "smoke:seven": "bun scripts/smoke-seven.ts",
    "check:versions": "bun scripts/check-versions.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.2.0",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
