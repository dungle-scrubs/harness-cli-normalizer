{
  "name": "@dungle-scrubs/harness-cli-normalizer",
  "version": "0.9.9",
  "description": "A unified interface across multiple coding agents.",
  "license": "MIT",
  "author": "Kevin Frilot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungle-scrubs/harness-cli-normalizer.git"
  },
  "homepage": "https://github.com/dungle-scrubs/harness-cli-normalizer#readme",
  "type": "module",
  "bin": {
    "hcn": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "skills"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:native": "node scripts/build-native.ts",
    "build:release": "node scripts/build.ts --release",
    "check": "pnpm check:task-state && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm test:bun && pnpm check:skill && pnpm check:package",
    "check:task-state": "node scripts/check-task-state.ts",
    "check:package": "node scripts/check-package.ts",
    "check:skill": "HCN_BIN=\"$PWD/dist/cli.js\" CHECK_CLAIMS_REQUIRE_SNAPSHOT=1 bash skills/hcn/scripts/check-claims.sh && HCN_BIN=\"$PWD/dist/cli.js\" bash test/skill/check-claims.test.sh",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun test --timeout=20000",
    "test:mutation": "pnpm test:mutation:failure && pnpm test:mutation:argv && pnpm test:mutation:content && pnpm test:mutation:session-input",
    "test:mutation:argv": "stryker run --mutate src/interpretation/argv.ts",
    "test:mutation:content": "stryker run --mutate src/interpretation/content.ts",
    "test:mutation:failure": "stryker run --mutate src/execution/failure.ts",
    "test:mutation:session-input": "stryker run --mutate src/interpretation/session-input.ts",
    "prepare": "node scripts/install-hooks.ts",
    "prepack": "pnpm build:release",
    "smoke:claude": "bun scripts/smoke-claude.ts",
    "smoke:all": "bun scripts/smoke-all.ts",
    "demo": "bun scripts/demo.ts",
    "smoke:seven": "bun scripts/smoke-seven.ts",
    "check:versions": "bun scripts/check-versions.ts",
    "smoke:questions": "bun scripts/smoke-questions.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@stryker-mutator/core": "10.0.0",
    "@types/node": "^26.6.5",
    "lefthook": "^2.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "koffi": "3.3.3"
  }
}
