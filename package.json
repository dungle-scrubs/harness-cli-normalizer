{
  "name": "@dungle-scrubs/harness-cli-normalizer",
  "version": "0.2.0",
  "description": "One stable interface to four coding-agent CLIs that survives their updates.",
  "license": "MIT",
  "author": "Kevin Frilot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungle-scrubs/harness-cli-normalizer.git"
  },
  "homepage": "https://github.com/dungle-scrubs/harness-cli-normalizer#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge/index.d.ts",
      "import": "./dist/knowledge/index.js"
    },
    "./interpretation": {
      "types": "./dist/interpretation/index.d.ts",
      "import": "./dist/interpretation/index.js"
    },
    "./execution": {
      "types": "./dist/execution/index.d.ts",
      "import": "./dist/execution/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:bun && pnpm build && pnpm check:package",
    "check:package": "node scripts/check-package.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun test",
    "prepare": "git config --local core.hooksPath .git/hooks && lefthook install --force",
    "prepack": "pnpm build",
    "smoke:claude": "bun scripts/smoke-claude.ts",
    "smoke:all": "bun scripts/smoke-all.ts",
    "demo": "bun scripts/demo.ts",
    "smoke:seven": "bun scripts/smoke-seven.ts",
    "check:versions": "bun scripts/check-versions.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.2.0",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
