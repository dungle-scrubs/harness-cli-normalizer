{
  "name": "@dungle-scrubs/harness-cli-normalizer",
  "version": "0.6.8",
  "description": "One stable CLI to four coding-agent harnesses: normalized flags, defaults, and events.",
  "license": "MIT",
  "author": "Kevin Frilot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungle-scrubs/harness-cli-normalizer.git"
  },
  "homepage": "https://github.com/dungle-scrubs/harness-cli-normalizer#readme",
  "type": "module",
  "bin": {
    "hcn": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:native": "node scripts/build-native.ts",
    "build:release": "node scripts/build.ts --release",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:bun && pnpm build && pnpm check:package",
    "check:package": "node scripts/check-package.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun test",
    "prepare": "node scripts/install-hooks.ts",
    "prepack": "pnpm build:release",
    "smoke:claude": "bun scripts/smoke-claude.ts",
    "smoke:all": "bun scripts/smoke-all.ts",
    "demo": "bun scripts/demo.ts",
    "smoke:seven": "bun scripts/smoke-seven.ts",
    "check:versions": "bun scripts/check-versions.ts",
    "smoke:questions": "bun scripts/smoke-questions.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "lefthook": "^2.1.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
