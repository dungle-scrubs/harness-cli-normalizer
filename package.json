{
  "name": "@dungle-scrubs/harness-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:bun",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun test",
    "prepare": "git config --local core.hooksPath .git/hooks && lefthook install --force",
    "smoke:claude": "bun scripts/smoke-claude.ts",
    "smoke:all": "bun scripts/smoke-all.ts",
    "demo": "bun scripts/demo.ts",
    "smoke:seven": "bun scripts/smoke-seven.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.2.0",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
